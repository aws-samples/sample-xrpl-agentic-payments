FROM public.ecr.aws/docker/library/python:3.13-slim

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY src/ /app/src/

RUN pip install --no-cache-dir .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
EXPOSE 8080

# opentelemetry-instrument (from aws-opentelemetry-distro) auto-instruments
# Strands/FastAPI/httpx/boto3 and exports spans/traces to AgentCore's managed
# collector — tracingEnabled on the CDK Runtime construct only grants the
# permissions and delivery pipeline; without this wrapper, no spans are ever
# produced to deliver. See docs/deployment.md#observability.
#
# No XRPL wallet secret or payment-table permission is available to this image.
CMD ["opentelemetry-instrument", "python", "-m", "xrpl_agentcore.agent_runtime"]
